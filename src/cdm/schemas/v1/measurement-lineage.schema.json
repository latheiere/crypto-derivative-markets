{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cdm:schema:measurement-lineage:1",
  "title": "CDM measurement lineage v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "output", "steps"],
  "properties": {
    "schema_id": { "const": "urn:cdm:schema:measurement-lineage:1" },
    "output": { "$ref": "urn:cdm:schema:datapoint:1" },
    "steps": {
      "type": "array",
      "minItems": 1,
      "prefixItems": [
        {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind"],
              "properties": { "kind": { "const": "native_reported" } }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "method_id"],
              "properties": {
                "kind": { "enum": ["provider_formula", "estimated"] },
                "method_id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*(?![\\s\\S])"
                }
              }
            }
          ]
        }
      ],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "method_id"],
        "properties": {
          "kind": { "enum": ["provider_formula", "canonical_conversion", "estimated"] },
          "method_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*(?![\\s\\S])"
          }
        }
      }
    }
  }
}

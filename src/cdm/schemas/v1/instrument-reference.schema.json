{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cdm:schema:instrument-reference:1",
  "title": "CDM instrument reference v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "descriptor"],
  "properties": {
    "schema_id": { "const": "urn:cdm:schema:instrument-reference:1" },
    "descriptor": { "$ref": "urn:cdm:schema:instrument-descriptor:1" },
    "native_identities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/native_identity" }
    }
  },
  "$defs": {
    "native_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "namespace", "value"],
      "properties": {
        "role": {
          "enum": [
            "instrument",
            "pair",
            "underlying",
            "index",
            "settlement_asset",
            "product_family",
            "other"
          ]
        },
        "namespace": {
          "type": "string",
          "pattern": "^(?:rest|websocket|fix|rpc)(?::[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*)*(?![\\s\\S])"
        },
        "value": { "type": "string", "minLength": 1 }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cdm:schema:open-interest-value:1",
  "title": "CDM open-interest value v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "amount", "measure"],
  "properties": {
    "schema_id": { "const": "urn:cdm:schema:open-interest-value:1" },
    "amount": {
      "type": "string",
      "pattern": "^(?:0|0\\.[0-9]*[1-9]|[1-9][0-9]*(?:\\.[0-9]*[1-9])?)(?![\\s\\S])"
    },
    "measure": { "enum": ["contract_count", "base_quantity", "notional"] },
    "denomination": { "enum": ["base", "quote", "settlement", "reporting"] }
  },
  "allOf": [
    {
      "if": { "properties": { "measure": { "const": "notional" } } },
      "then": { "required": ["denomination"] },
      "else": { "not": { "required": ["denomination"] } }
    }
  ]
}
